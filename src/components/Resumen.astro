<section
	class="grid grid-cols-3 divide-x divide-white/20 rounded-lg bg-linear-to-br from-indigo-600 to-violet-600 text-white"
	aria-label="Resumen general del inventario"
>
	<div class="flex flex-col gap-1 p-4">
		<span class="text-xs text-white/70">Inicial</span>
		<strong id="total-inicial" class="text-2xl font-semibold tabular-nums">0</strong>
	</div>
	<div class="flex flex-col gap-1 p-4">
		<span class="text-xs text-white/70">Vendidos</span>
		<strong id="total-vendidos" class="text-2xl font-semibold tabular-nums">0</strong>
	</div>
	<div class="flex flex-col gap-1 p-4">
		<span class="text-xs text-white/70">Disponibles</span>
		<strong id="total-disponibles" class="text-2xl font-semibold tabular-nums">0</strong>
	</div>
</section>
