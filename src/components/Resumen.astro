---
---

<section
	class="rounded-2xl bg-gradient-to-br from-indigo-600 to-violet-600 p-5 text-white shadow-sm"
	aria-label="Resumen general del inventario"
>
	<h2 class="mb-3 text-xs font-semibold tracking-widest uppercase opacity-85">Inventario</h2>
	<div class="grid grid-cols-3 gap-3">
		<div class="flex flex-col">
			<span class="text-xs opacity-85">Inicial</span>
			<strong id="total-inicial" class="text-2xl font-bold tabular-nums sm:text-3xl">0</strong>
		</div>
		<div class="flex flex-col">
			<span class="text-xs opacity-85">Vendidos</span>
			<strong id="total-vendidos" class="text-2xl font-bold tabular-nums sm:text-3xl">0</strong>
		</div>
		<div class="flex flex-col">
			<span class="text-xs opacity-85">Disponibles</span>
			<strong id="total-disponibles" class="text-2xl font-bold tabular-nums sm:text-3xl">0</strong>
		</div>
	</div>
</section>
