---
---

<details open class="rounded-lg border border-stone-200 bg-white">
	<summary
		class="flex cursor-pointer items-center gap-2 px-4 py-3 text-sm font-semibold text-stone-900 select-none list-none [&::-webkit-details-marker]:hidden"
	>
		<span
			class="inline-flex h-5 w-5 items-center justify-center rounded-md bg-indigo-600 text-xs font-bold text-white transtion hover:bg-indigo-700"
		>
			+
		</span>
		Agregar referencia
	</summary>

	<form
		id="form-producto"
		class="grid items-end gap-3 border-t border-stone-200 p-4 md:grid-cols-[2fr_1fr_1fr_1fr_auto]"
		autocomplete="off"
	>
		<label class="flex flex-col gap-1.5">
			<span class="text-xs font-medium text-stone-500">Referencia</span>
			<input
				type="text"
				id="nombre"
				name="nombre"
				placeholder="Ej: Bioaqua Arroz"
				maxlength="60"
				required
				class="w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 outline-none transition focus:border-stone-900"
			/>
		</label>

		<label class="flex flex-col gap-1.5">
			<span class="text-xs font-medium text-stone-500">Cantidad inicial</span>
			<input
				type="number"
				id="cantidad"
				name="cantidad"
				min="0"
				step="1"
				inputmode="numeric"
				value="1"
				required
				class="w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 outline-none transition focus:border-stone-900"
			/>
		</label>

		<label class="flex flex-col gap-1.5">
			<span class="text-xs font-medium text-stone-500">Precio compra</span>
			<div class="relative">
				<span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-stone-400">$</span>
				<input
					type="text"
					id="precio-compra"
					name="precio-compra"
					inputmode="numeric"
					placeholder="0"
					class="w-full rounded-lg border border-stone-300 bg-white py-2.5 pr-3 pl-7 outline-none transition focus:border-stone-900"
				/>
			</div>
		</label>

		<label class="flex flex-col gap-1.5">
			<span class="text-xs font-medium text-stone-500">Precio venta</span>
			<div class="relative">
				<span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-stone-400">$</span>
				<input
					type="text"
					id="precio-venta"
					name="precio-venta"
					inputmode="numeric"
					placeholder="0"
					class="w-full rounded-lg border border-stone-300 bg-white py-2.5 pr-3 pl-7 outline-none transition focus:border-stone-900"
				/>
			</div>
		</label>

		<button
			type="submit"
			class="rounded-lg bg-indigo-600 px-6 py-2.5 font-semibold text-white transition hover:bg-indigo-700"
		>
			Agregar
		</button>
	</form>
</details>
