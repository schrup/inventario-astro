---
---

<template id="producto-template">
	<article
		class="producto group flex min-w-0 flex-col gap-4 rounded-lg border border-stone-200 bg-white p-4 data-[agotado=true]:border-rose-300 data-[agotado=true]:bg-rose-50"
	>
		<div class="flex items-start justify-between gap-2">
			<h3 class="producto__nombre text-base font-semibold break-words text-stone-900"></h3>
			<button
				type="button"
				class="producto__eliminar shrink-0 text-x text-stone-400 transition hover:text-rose-600"
			>
				Eliminar
			</button>
		</div>

		<div class="flex items-end justify-between gap-3">
			<div class="min-w-0">
				<p class="m-0 text-xs text-stone-500">Disponibles</p>
				<p
					class="producto__disponibles m-0 text-5xl leading-none font-bold text-stone-900 tabular-nums group-data-[agotado=true]:text-rose-600"
				>
					0
				</p>
			</div>
			<dl class="m-0 flex shrink-0 flex-col gap-1.5 text-xs text-stone-500">
				<div class="flex justify-between gap-3">
					<dt>Inicial</dt>
					<dd class="producto__inicial m-0 font-semibold text-stone-700 tabular-nums">0</dd>
				</div>
				<div class="flex justify-between gap-3">
					<dt>Vendidos</dt>
					<dd class="producto__vendidos m-0 font-semibold text-stone-700 tabular-nums">0</dd>
				</div>
			</dl>
		</div>

		<div class="flex justify-between border-t border-stone-100 pt-3">
			<div>
				<p class="m-0 text-xs text-stone-500">Compra</p>
				<p class="producto__precio-compra m-0 text-sm font-medium whitespace-nowrap text-stone-700 tabular-nums">—</p>
			</div>
			<div class="text-right">
				<p class="m-0 text-xs text-stone-500">Venta</p>
				<p class="producto__precio-venta m-0 text-sm font-semibold whitespace-nowrap text-stone-900 tabular-nums">—</p>
			</div>
		</div>

		<button
			type="button"
			class="producto__vender rounded-lg bg-emerald-700 py-3 font-semibold text-white transition hover:bg-emerald-800 disabled:cursor-not-allowed disabled:bg-stone-200 disabled:text-stone-400"
		>
			Vendido
		</button>
	</article>
</template>
