---
---

<template id="producto-template">
	<article
		class="producto group flex flex-col gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm data-[agotado=true]:border-rose-300"
	>
		<div class="flex items-start justify-between gap-2">
			<h3 class="producto__nombre text-lg font-semibold break-words"></h3>
			<button
				type="button"
				class="producto__eliminar shrink-0 rounded-lg px-2 py-1 text-sm font-medium text-rose-600 transition hover:bg-rose-50"
			>
				Eliminar
			</button>
		</div>

		<dl class="producto__datos m-0 grid grid-cols-3 gap-2 text-center">
			<div class="rounded-lg bg-slate-50 py-2">
				<dt class="text-[0.7rem] tracking-wide text-slate-500 uppercase">Inicial</dt>
				<dd class="producto__inicial m-0 text-lg font-bold tabular-nums">0</dd>
			</div>
			<div class="rounded-lg bg-slate-50 py-2">
				<dt class="text-[0.7rem] tracking-wide text-slate-500 uppercase">Vendidos</dt>
				<dd class="producto__vendidos m-0 text-lg font-bold tabular-nums text-indigo-600">0</dd>
			</div>
			<div class="rounded-lg bg-slate-50 py-2">
				<dt class="text-[0.7rem] tracking-wide text-slate-500 uppercase">Disponibles</dt>
				<dd
					class="producto__disponibles m-0 text-lg font-bold tabular-nums text-emerald-600 group-data-[agotado=true]:text-rose-600"
				>
					0
				</dd>
			</div>
		</dl>

		<button
			type="button"
			class="producto__vender rounded-xl bg-emerald-600 py-2.5 font-semibold text-white transition hover:bg-emerald-700 disabled:cursor-not-allowed disabled:bg-slate-300"
		>
			Vendido
		</button>
	</article>
</template>
