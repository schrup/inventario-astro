---
---

<dialog
	id="dialogo-eliminar"
	class="m-auto w-[min(100%-2rem,22rem)] rounded-lg border border-stone-200 bg-white p-0 text-stone-900 backdrop:bg-stone-900/40"
>
	<form method="dialog" class="flex flex-col gap-4 p-5">
		<div class="flex flex-col gap-1.5">
			<h2 class="text-base font-semibold">Eliminar referencia</h2>
			<p class="m-0 text-sm text-stone-500">
				Se eliminará <strong id="dialogo-eliminar-texto" class="font-semibold break-words text-stone-900"></strong>
				junto con su historial de ventas. Esta acción no se puede deshacer.
			</p>
		</div>
		<div class="flex justify-end gap-2">
			<button
				type="submit"
				value="cancelar"
				autofocus
				class="rounded-lg border border-stone-300 bg-white px-4 py-2 text-sm font-medium text-stone-700 transition hover:bg-stone-50"
			>
				Cancelar
			</button>
			<button
				type="submit"
				value="confirmar"
				class="rounded-lg bg-rose-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-rose-700"
			>
				Eliminar
			</button>
		</div>
	</form>
</dialog>
