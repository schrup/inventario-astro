---

<section
	class="grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-stone-200 bg-stone-200 sm:grid-cols-4"
	aria-label="Contabilidad"
>
	<div class="flex flex-col gap-1 bg-white p-4">
		<span class="text-xs text-stone-500">Inversión inicial</span>
		<strong id="total-inversion" class="text-xl font-semibold whitespace-nowrap text-stone-900 tabular-nums">$ 0</strong>
	</div>
	<div class="flex flex-col gap-1 bg-white p-4">
		<span class="text-xs text-stone-500">Total ventas</span>
		<strong id="total-ventas" class="text-xl font-semibold whitespace-nowrap text-stone-900 tabular-nums">$ 0</strong>
	</div>
	<div class="flex flex-col gap-1 bg-white p-4">
		<span class="text-xs text-stone-500">Recuperación de inversión</span>
		<strong id="total-recuperacion" class="text-xl font-semibold whitespace-nowrap text-stone-900 tabular-nums">$ 0</strong>
	</div>
	<div class="flex flex-col gap-1 bg-white p-4">
		<span class="text-xs text-stone-500">Rentabilidad bruta</span>
		<strong id="total-rentabilidad" class="text-xl font-semibold whitespace-nowrap text-stone-900 tabular-nums">$ 0</strong>
	</div>
</section>
