---
import '../styles/global.css';

interface Props {
	title?: string;
}

const { title = 'Inventario | Feria de emprendimiento' } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Control sencillo de inventario y ventas para una feria de emprendimiento." />
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-slate-100 text-slate-800 antialiased">
		<slot />
	</body>
</html>
